<suite name="Login Suite"
       parallel="tests"
       thread-count="2">

    <test name="Valid Login">

        <parameter name="dataFile"
                   value="LoginTestData.xlsx"/>

        <parameter name="dataSheet"
                   value="ValidLogin"/>

        <classes>
            <class name="testRunner.TestRunner"/>
        </classes>

    </test>

    <test name="Invalid Login">

        <parameter name="dataFile"
                   value="LoginTestData.xlsx"/>

        <parameter name="dataSheet"
                   value="InvalidLogin"/>

        <classes>
            <class name="testRunner.TestRunner"/>
        </classes>

    </test>

</suite>
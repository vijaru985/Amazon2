<suite name="Login Suite"
       parallel="tests"
       thread-count="2">

    <test name="Valid Login" enabled="false">

        <parameter name="dataFile"
                   value="LoginTestData.xlsx"/>

        <parameter name="dataSheet"
                   value="ValidLogin"/>

        <classes>
            <class name="testRunner.TestRunner"/>
        </classes>

    </test>

    <test name="Invalid Login" enabled="false">

        <parameter name="dataFile"
                   value="LoginTestData.xlsx"/>

        <parameter name="dataSheet"
                   value="InvalidLogin"/>

        <classes>
            <class name="testRunner.TestRunner"/>
        </classes>

    </test>
    
    <test name="Database Login" enabled="false">

        <parameter name="dataFile"
                   value="LoginTestData.xlsx"/>

        <parameter name="dataSheet"
                   value="DatabaseLogin"/>

        <classes>
            <class name="testRunner.TestRunner"/>
        </classes>

    </test>
    
    <test name="Eligibility API Test">

        <parameter name="dataFile"
                   value="CommonTestData.xlsx"/>

        <parameter name="dataSheet"
                   value="CommonTestcases"/>

        <classes>
            <class name="testRunner.TestRunner"/>
        </classes>

    </test>

</suite>